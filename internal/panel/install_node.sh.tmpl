#!/bin/sh
#
# Установщик ноды Veil. Выдан панелью {{.Panel}}.
#
# Приглашение внутри одноразовое и живёт час. Повторно этот скрипт не сработает:
# получи в панели новую команду.
#
# Что можно поменять, не редактируя файл:
#   PORT=8443 — если 443 занят (в бою так лучше не делать, см. ниже)
#   DEST=www.icloud.com:443 — другой сайт прикрытия
#   NAME=amsterdam-1 — как нода будет называться в панели
#   COUNTRY=Нидерланды — страна, которую увидит покупатель (можно указать потом)

set -eu

PANEL='{{.Panel}}'
INVITE='{{.Token}}'
PORT="${PORT:-443}"
DEST="${DEST:-www.samsung.com:443}"
NAME="${NAME:-$(hostname 2>/dev/null || echo нода)}"
COUNTRY="${COUNTRY:-}"
DIR=/opt/veil-node

say() { printf '%s\n' "$*"; }
die() { printf '\nустановка прервана: %s\n' "$*" >&2; exit 1; }

# ---------------------------------------------------------------- проверки

[ "$(id -u)" = 0 ] || die 'нужны права root'
command -v systemctl >/dev/null 2>&1 || die 'на этой системе нет systemd, автозапуск настроить нечем'
command -v curl >/dev/null 2>&1 || die 'нет curl. Поставь: apt-get install -y curl'

if [ -d "$DIR" ]; then
	die "$DIR уже существует. Здесь, похоже, уже стоит нода. Снести: systemctl disable --now veil-node && rm -rf $DIR"
fi

# Порт должен быть свободен до того, как мы что-то скачаем и запишем.
# Обнаружить занятость после установки — значит оставить человека с
# наполовину поставленной нодой и невнятной ошибкой в журнале.
if command -v ss >/dev/null 2>&1; then
	if ss -tln 2>/dev/null | awk '{print $4}' | sed 's/.*://' | grep -qx "$PORT"; then
		die "порт $PORT уже занят. Освободи его или поставь ноду на отдельный сервер. Проверить, кто держит: ss -tlnp | grep :$PORT"
	fi
fi

if [ "$PORT" != "443" ]; then
	say "ВНИМАНИЕ: нода встанет на порт $PORT, а не 443."
	say "Настоящие сайты на нестандартных портах не живут, и это заметно со стороны."
	say "Вдобавок корпоративные и гостиничные сети такие порты часто режут."
	say ""
fi

# ---------------------------------------------------------------- сайт прикрытия

DEST_HOST="${DEST%:*}"

say "проверяю сайт прикрытия $DEST_HOST"
if ! curl -sI --max-time 10 --tlsv1.3 "https://$DEST_HOST/" -o /dev/null 2>/dev/null; then
	die "сайт прикрытия $DEST_HOST недоступен отсюда или не умеет TLS 1.3. Возьми другой: DEST=www.icloud.com:443"
fi

# ---------------------------------------------------------------- установка

say "скачиваю ядро"
mkdir -p "$DIR"
chmod 700 "$DIR"

curl -fsSL "$PANEL/install/$INVITE/veil-server" -o "$DIR/veil-server" || die 'не скачался veil-server'
curl -fsSL "$PANEL/install/$INVITE/veil-keygen" -o "$DIR/veil-keygen" || die 'не скачался veil-keygen'
chmod 755 "$DIR/veil-server" "$DIR/veil-keygen"

say "выпускаю ключи"
umask 077

"$DIR/veil-keygen" > "$DIR/.k1" 2>&1
"$DIR/veil-keygen" -reality > "$DIR/.k2" 2>&1

NODE_KEY=$(awk '/Приватный ключ:/{print $3; exit}' "$DIR/.k1")
NODE_PUB=$(awk '/Публичный ключ:/{print $3; exit}' "$DIR/.k1")
REALITY_KEY=$(awk '/Приватный ключ:/{print $3; exit}' "$DIR/.k2")
REALITY_PUB=$(awk '/Публичный ключ:/{print $3; exit}' "$DIR/.k2")
SHORT_ID=$(head -c 8 /dev/urandom | od -An -tx1 | tr -d ' \n')

rm -f "$DIR/.k1" "$DIR/.k2"
[ -n "$NODE_KEY" ] && [ -n "$REALITY_KEY" ] || die 'не получилось выпустить ключи'

printf '%s\n' "$NODE_KEY" > "$DIR/node.key"
chmod 600 "$DIR/node.key"

# ---------------------------------------------------------------- запись в панель

say "записываюсь в панель"

# Адрес не отправляем: за NAT нода видит свой внутренний, а панель видит
# настоящий, с которого пришло соединение.
BODY=$(printf '{"name":"%s","country":"%s","port":%s,"sni":"%s","public_key":"%s","reality_public_key":"%s","reality_short_id":"%s"}' \
	"$NAME" "$COUNTRY" "$PORT" "$DEST_HOST" "$NODE_PUB" "$REALITY_PUB" "$SHORT_ID")

RESP=$(curl -fsS -X POST "$PANEL/api/v1/nodes/register" \
	-H "Authorization: Bearer $INVITE" \
	-H 'Content-Type: application/json' \
	-d "$BODY") || die 'панель не приняла ноду. Скорее всего приглашение уже использовано или просрочено — возьми в панели новую команду'

NODE_TOKEN=$(printf '%s' "$RESP" | sed -n 's/.*"token":"\([^"]*\)".*/\1/p')
[ -n "$NODE_TOKEN" ] || die "панель ответила непонятным: $RESP"

# Секреты уезжают в файл окружения, а не в строку запуска. В строке запуска
# их видел бы любой пользователь системы через ps.
cat > "$DIR/env" <<ENVEOF
VEIL_NODE_TOKEN=$NODE_TOKEN
VEIL_REALITY_KEY=$REALITY_KEY
ENVEOF
chmod 600 "$DIR/env"

# ---------------------------------------------------------------- служба

say "настраиваю автозапуск"

id -u veil >/dev/null 2>&1 || useradd --system --no-create-home --shell /usr/sbin/nologin veil
chown -R veil:veil "$DIR"

cat > /etc/systemd/system/veil-node.service <<UNITEOF
[Unit]
Description=Veil node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=veil
Group=veil
WorkingDirectory=$DIR
EnvironmentFile=$DIR/env
ExecStart=$DIR/veil-server -listen 0.0.0.0:$PORT -key-file $DIR/node.key -panel $PANEL -reality-dest $DEST -reality-short-id $SHORT_ID
Restart=on-failure
RestartSec=3

# Нода не root: единственное, ради чего ей нужны были права, — занять
# порт ниже 1024, и это выдаётся отдельной возможностью.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=$DIR

[Install]
WantedBy=multi-user.target
UNITEOF

systemctl daemon-reload
systemctl enable --now veil-node >/dev/null 2>&1

# Даём службе мгновение подняться и проверяем, что она действительно жива.
# «Установка завершена» при упавшей службе — худшее, что может напечатать
# установщик: человек уходит довольный, а работать начинает завтра.
i=0
while [ "$i" -lt 10 ]; do
	if [ "$(systemctl is-active veil-node)" = active ]; then
		break
	fi
	i=$((i + 1))
	sleep 1
done

if [ "$(systemctl is-active veil-node)" != active ]; then
	say ''
	say 'служба не поднялась. Последние строки журнала:'
	journalctl -u veil-node -n 15 --no-pager -o cat || true
	die 'нода не запустилась'
fi

say ''
say '════════════════════════════════════════════'
say " нода поднята и записана в панель"
say ''
say " имя           $NAME"
say " порт          $PORT"
say " прикрытие     $DEST"
say ''
say " журнал        journalctl -u veil-node -f"
say " снести        systemctl disable --now veil-node && rm -rf $DIR /etc/systemd/system/veil-node.service"
say '════════════════════════════════════════════'
