<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        allowBackup выключен намеренно. В настройках лежит ключ доступа, а в
        нём личный ключ покупателя. Включённое резервное копирование отправило
        бы его в облако производителя телефона, то есть вынесло бы наружу
        ровно то, ради чего всё и затевалось.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Veil">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Ссылку из телеграма покупатель просто нажимает. Без этого он
                держит её в буфере обмена, ищет приложение и вставляет вручную —
                и именно здесь теряется тот, ради кого всё делается.

                Своя схема, а не https: у покупателя не должно быть шага, на
                котором ссылка уходит в браузер, а с ней и адрес панели
                продавца — в историю, синхронизацию и подсказки поиска.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="marvia" />
                <!-- Старая схема: ключи, выданные до переименования, живут в переписке покупателей и должны открываться по-прежнему. -->
                <data android:scheme="veil-account" />
            </intent-filter>
        </activity>

        <!--
            specialUse — единственный подходящий вид постоянной службы: своего
            вида для VPN в Android не завели, а без постоянной службы система
            выгрузит нас из памяти вместе с туннелем.
        -->
        <service
            android:name=".VeilVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn" />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    </application>
</manifest>
