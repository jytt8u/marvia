<?xml version="1.0" encoding="utf-8"?>
<!--
    Английский лежит в values по умолчанию, русский — в values-ru.

    Так задумано в Android: values — запасной вариант для всех, у кого нет
    своей папки. Держать в нём русский значило бы показывать русские надписи
    человеку с турецким или персидским телефоном — а это ровно те, ради кого
    приложение и делается.
-->
<resources>
    <string name="app_name">Marvia</string>

    <string name="status_off">Disconnected</string>
    <string name="status_connecting">Connecting…</string>
    <string name="status_on">Connected</string>
    <string name="status_failed">Could not connect</string>

    <string name="detail_off">Traffic goes directly</string>
    <string name="detail_connecting">Picking the fastest node</string>
    <string name="detail_no_key">Paste your access key</string>
    <string name="detail_node">Node: %1$s</string>
    <string name="detail_node_warning">Node: %1$s · %2$s</string>

    <!-- Подписка: до какого числа и сколько трафика осталось. -->
    <string name="sub_until">Until %1$s</string>
    <string name="sub_until_left">Until %1$s · %2$s left</string>
    <string name="sub_left">%1$s left</string>
    <string name="sub_unlimited">Unlimited</string>
    <string name="size_gb">%1$s GB</string>
    <string name="size_mb">%1$d MB</string>

    <string name="action_connect">Connect</string>
    <string name="action_disconnect">Disconnect</string>
    <string name="action_save">Save the key</string>

    <string name="key_hint">Access key</string>
    <string name="key_helper">A marvia://… link — the bot sends it on payment</string>
    <string name="key_saved">Key saved</string>
    <string name="key_empty">The field is empty</string>

    <!--
        Ссылку приложению может подсунуть любое другое приложение или страница,
        не только бот продавца. Пока ключа нет, менять нечего — берём молча.
        Когда ключ уже стоит, подмена увела бы весь трафик на чужие серверы,
        поэтому спрашиваем.
    -->
    <string name="key_replace_title">Replace the access key?</string>
    <string name="key_replace_body">This link came from another app. After replacing it, your traffic goes through the servers of whoever issued it. Agree only if the link came from your seller.</string>
    <string name="key_replace_yes">Replace</string>
    <string name="key_replace_no">Keep the old one</string>

    <!--
        Байпас. Значок VPN в шторке остаётся всегда — его рисует Android, пока
        поднят туннель. Но местные сервисы ломает не значок, а зарубежный адрес
        ноды, и вот его исключение из туннеля и чинит.
    -->
    <string name="bypass_open">Apps outside the tunnel</string>
    <string name="bypass_title">What to keep out of the tunnel</string>
    <string name="bypass_none">Every app goes through the tunnel</string>
    <string name="bypass_some">Outside the tunnel: %1$d</string>
    <string name="bypass_hint">Government services, banks and other local sites often refuse requests coming from abroad. Send them outside — they keep an ordinary connection with a local address.</string>
    <string name="bypass_preset">Government services and banks</string>
    <string name="bypass_save">Save</string>
    <string name="bypass_restart">Changes apply on the next connection</string>
    <string name="bypass_loading">Looking at what is installed…</string>

    <!--
        Местные сайты мимо туннеля. Предлагаем при первом удачном подключении:
        про эту возможность человек вспоминает ровно тогда, когда у него не
        открылся банк, — то есть уже разозлившись.
    -->
    <string name="bypass_ru_title">Local sites outside the tunnel?</string>
    <string name="bypass_ru_body">Government services, banks and mail often refuse requests from abroad. Sent outside, they open as usual, while everything else keeps going through the tunnel.</string>
    <string name="bypass_ru_yes">Send them outside</string>
    <string name="bypass_ru_no">No need</string>
    <string name="bypass_ru_on">Local sites outside</string>

    <!--
        Настройки. Здесь нет ручек протокола: их место внутри, а не на экране
        человека, который не может выбрать между ними осознанно.
    -->
    <string name="settings_title">Settings</string>
    <string name="settings_apps">Apps outside the tunnel</string>
    <string name="settings_autostart_off">Start after reboot: no</string>
    <string name="settings_autostart_on">Start after reboot: yes</string>
    <string name="settings_autostart_short">autostart</string>
    <string name="settings_autostart_saved">The tunnel will come up by itself after a reboot</string>
    <string name="settings_autostart_off_saved">After a reboot you will have to turn it on by hand</string>
    <string name="settings_always_on">Always-on VPN in the system</string>
    <string name="settings_always_on_missing">This phone has no such settings screen</string>
    <string name="settings_theme">Theme</string>
    <string name="settings_journal">Log</string>
    <string name="theme_system">Follow the system</string>
    <string name="theme_light">Light</string>
    <string name="theme_dark">Dark</string>
    <string name="journal_send">Send to the seller</string>

    <string name="consent_denied">The tunnel cannot start without the system's permission</string>
    <string name="error_no_interface">The system did not give out a network interface</string>

    <!--
        Фразы под виды неудач из ядра. Задача каждой — сказать человеку, что
        делать дальше, а не что именно сломалось внутри.
    -->
    <!--
        Кончившаяся подписка — самая частая беда и единственная, где человеку
        надо не чинить, а заплатить. Раньше он читал «ни один сервер не
        отвечает», шёл к продавцу с «у вас всё сломалось», и продавец
        разбирался с каждым таким вручную.
    -->
    <string name="fail_expired">Your subscription has ended. Renew it with your seller — access comes back at once</string>
    <string name="fail_quota">You are out of paid traffic. Ask your seller to add more</string>

    <string name="fail_account">The access key was not accepted. Get a new one from your seller</string>
    <string name="fail_panel">Cannot fetch the server list. Check that you have internet</string>
    <string name="fail_nodes">No server is responding right now. Try later or write to your seller</string>
    <string name="fail_system">The phone would not create the connection. Try again</string>

    <string name="notification_channel">Tunnel</string>
    <string name="notification_channel_desc">Shows whether the tunnel is running</string>
    <string name="notification_stop">Disconnect</string>

    <!--
        Строки журнала. Журнал человек отправляет продавцу, то есть читает его
        не только он, — поэтому он такой же перевод, как и всё остальное.
    -->
    <string name="log_header">Marvia · log</string>
    <string name="log_bypassed">apps outside the tunnel: %1$d</string>
    <string name="log_bypass_local">, local subnets outside: %1$s</string>
    <string name="log_yes">yes</string>
    <string name="log_no">no</string>
    <string name="log_tunnel_on">turning the tunnel on</string>
    <string name="log_connected">connected through %1$s</string>
    <string name="log_failed">did not come up: %1$s — %2$s</string>
</resources>
